{
  "name": "service-port-scanner",
  "version-string": "0.1.0",
  "builtin-baseline": "67b207f199b5d2ee09f206d2e9e9171e7c7a3274",
  "dependencies": [
    "boost-asio",
    "boost-system",
    "openssl",
    "spdlog",
    "fmt",
    "nlohmann-json",
    "cli11",
    "catch2"
  ],
  "features": {
    "gui": {
      "description": "Qt6 GUI front-end (qtbase + qtcharts) + Qt6::Test for qt_bridge_test",
      "dependencies": [
        { "name": "qtbase",  "default-features": false, "features": ["widgets", "testlib"] },
        "qtcharts"
      ]
    },
    "extras": {
      "description": "Optional helper libs (config parser, enum reflect, expected backport, http probe via Beast)",
      "dependencies": [
        "boost-beast",
        "tomlplusplus",
        "magic-enum",
        "tl-expected"
      ]
    }
  }
}
